# Auth API base URL (Auth-клиент axios; withCredentials только для него)
VITE_AUTH_API_BASE_URL=/api/auth

# Realm-константа деплоя (domain/group), обязательна на signin/signup/check-login
VITE_AUTH_REALM=account-template/standard

# Стратегия хранения refresh: cookie (веб-прод) | body (dev/кросс-домен)
VITE_TOKEN_MODE=cookie

# Адрес условий использования сервиса: туда ведёт ссылка из оговорки под кнопкой регистрации.
# Документ принадлежит деплою, а не фронту — маршрута /terms в приложении нет, дефолтный путь
# отдаёт сторона деплоя. Внешний адрес (https://…) подходит так же.
VITE_TERMS_URL=/terms

# Включить MSW-моки Auth API (1 = включено, 0 = выключено). При сборке с mode=production код
# подъёма моков вырезается, и '1' там ничего не включает (сам файл воркера
# public/mockServiceWorker.js в dist попадает, но без регистрации не активен). В деве по умолчанию
# включено, так что задавать флаг нужно только чтобы работать против живого бэкенда (0).
VITE_ENABLE_MOCKS=1

# Только для моков: 0 = у пользователя один кабинет (в профиле нет карточки «Кабинеты»,
# на /sessions нет выбора кабинета). По умолчанию — несколько кабинетов.
VITE_MOCK_MULTI_REALM=1

# Только для моков: 1 = «сервер не знает» английский язык, сохранение en-US на /settings даёт 400
# по полю lang. Нужно, чтобы посмотреть ветку «список фронта отстал от серверного» руками;
# по умолчанию выключено, иначе в демо нельзя сохранить английский язык профиля.
# У пояса такой флаг не нужен: там для этого есть необитаемая зона (см. MOCK_REJECTED_TZ).
VITE_MOCK_REJECT_LANG=0

# Только для моков: НАЧАЛЬНЫЙ второй фактор в профиле — PASSWORD | TOTP; пусто/иное = 2FA выключена
# (как у свежего аккаунта). Дальше фактором распоряжаются методы /v1/security/*: apply-password и
# apply-totp его включают, apply-operation по операции отключения — выключает, так что флаг задаёт
# лишь точку старта. Обычному входу включённый фактор добавляет второе звено (код с емаила, затем
# пароль/TOTP — вместо него принимается и аварийный код); резервному входу (/signin/recovery) он
# выбирает первое звено цепочки. Звено одно и то же: TOTP при TOTP, иначе пароль. Ветку «у аккаунта
# 2FA нет, подтвердить нечем» мок не изображает — резервный вход проходится при любом значении
# флага. Секреты печатаются в консоль на каждом звене.
VITE_MOCK_2FA=

# Только для моков: НАЧАЛЬНЫЙ остаток аварийных кодов в профиле (целое ≥ 0, по умолчанию 8). Поле
# приходит ТОЛЬКО при включённой 2FA, поэтому без VITE_MOCK_2FA значение не используется, а после
# выдачи набора (apply-password / apply-totp / apply-recovery-codes) его сменяет размер набора.
# Предупреждение на полосе защиты показано не при любом остатке — веток четыре: 0 — «закончились»,
# 1 — «остался последний», 2..3 — «осталось N», 4 и больше — строки нет вовсе (дефолт такой).
# Флаг сокращает путь, но не открывает ветку в одиночку: принятый аварийный код убавляет остаток,
# так что до нуля можно дойти и руками, а на нуле код перестаёт подтверждать что-либо. Убавляет
# только при включённой 2FA: у аккаунта без неё набора нет вовсе, и резервный вход ему остаётся
# проходимым сколько угодно раз.
VITE_MOCK_RECOVERY_CODES=8

# Только для моков: 1 = первое открытие сессии по подтверждённой операции отклоняется 429
# (лимит одновременных сессий, Retry-After 30с), повтор проходит. Нужно, чтобы посмотреть руками
# ветку «код принят, войти не удалось»: экран прячет поле кода и предлагает «Повторить».
# По умолчанию выключено.
VITE_MOCK_SESSION_LIMIT=0
