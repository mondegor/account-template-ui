# Auth API base URL (Auth-клиент axios; withCredentials только для него)
VITE_AUTH_API_BASE_URL=/api/auth

# Realm-константа деплоя (domain/group), обязательна на signin/signup/check-login
VITE_AUTH_REALM=print-shop/standard

# Стратегия хранения refresh: cookie (веб-прод) | body (dev/кросс-домен)
VITE_TOKEN_MODE=cookie

# Включить MSW-моки Auth API (1 = включено, 0 = выключено). При сборке с mode=production код
# подъёма моков вырезается, и '1' там ничего не включает (сам файл воркера
# public/mockServiceWorker.js в dist попадает, но без регистрации не активен). В деве по умолчанию
# включено, так что задавать флаг нужно только чтобы работать против живого бэкенда (0).
VITE_ENABLE_MOCKS=1

# Только для моков: 0 = у пользователя один кабинет (в профиле нет карточки «Кабинеты»,
# на /sessions нет выбора кабинета). По умолчанию — несколько кабинетов.
VITE_MOCK_MULTI_REALM=1

# Только для моков: 1 = «сервер не знает» английский язык, сохранение en-US на /settings даёт 400
# по полю lang. Нужно, чтобы посмотреть ветку «список фронта отстал от серверного» руками;
# по умолчанию выключено, иначе в демо нельзя сохранить английский язык профиля.
# У пояса такой флаг не нужен: там для этого есть необитаемая зона (см. MOCK_REJECTED_TZ).
VITE_MOCK_REJECT_LANG=0

# Только для моков: второй фактор в ПРОФИЛЕ — PASSWORD | TOTP; пусто/иное = 2FA выключена
# (как у свежего аккаунта). На сам вход не влияет: цепочку со вторым звеном мок не изображает,
# подтверждение у него всегда одношаговое.
VITE_MOCK_2FA=

# Только для моков: остаток аварийных кодов в профиле (целое ≥ 0, по умолчанию 8). Поле приходит
# ТОЛЬКО при включённой 2FA, поэтому без VITE_MOCK_2FA значение не используется. Предупреждение на
# полосе защиты показано не при любом остатке — веток четыре: 0 — «закончились», 1 — «остался
# последний», 2..3 — «осталось N», 4 и больше — строки нет вовсе (запаса хватает; дефолт такой).
VITE_MOCK_RECOVERY_CODES=8

# Только для моков: 1 = первое открытие сессии по подтверждённой операции отклоняется 429
# (лимит одновременных сессий, Retry-After 30с), повтор проходит. Нужно, чтобы посмотреть руками
# ветку «код принят, войти не удалось»: экран прячет поле кода и предлагает «Повторить».
# По умолчанию выключено.
VITE_MOCK_SESSION_LIMIT=0
